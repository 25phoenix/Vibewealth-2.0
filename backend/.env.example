# Local PostgreSQL settings for Docker Compose.
# Replace the placeholder password in your private .env file before starting the database.
POSTGRES_DB=vibewealth
POSTGRES_USER=vibewealth_app
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_PORT=5432

# Reserved for future backend database integration; the API does not connect yet.
DATABASE_URL=postgresql+psycopg://vibewealth_app:replace-with-a-local-secret@localhost:5432/vibewealth

APP_TITLE=VibeWealth API
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173"]
