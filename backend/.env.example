# Local PostgreSQL settings for Docker Compose.
# Replace the placeholder password in your private .env file before starting the database.
POSTGRES_DB=vibewealth
POSTGRES_USER=vibewealth_app
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional override. Leave blank to build the URL safely from POSTGRES_* values.
DATABASE_URL=

APP_TITLE=VibeWealth API
APP_VERSION=0.1.0

# Required environment selector. This template explicitly opts into local development.
# Never copy the insecure-cookie setting below into a production environment.
APP_ENVIRONMENT=development
# Local browser authentication settings. Insecure cookies are permitted only
# when explicitly enabled in development over HTTP.
ALLOWED_FRONTEND_ORIGINS=["http://localhost:5173"]
ALLOW_INSECURE_COOKIES=true
# Optional in development (uses a development-only fallback when blank).
# Production requires a unique secret generated with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CSRF_SIGNING_SECRET=

# Process-local public authentication rate limits. Limits apply to all attempts.
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_IDENTITY_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_REGISTRATION_IP_LIMIT=5
AUTH_REGISTRATION_IDENTITY_LIMIT=2
AUTH_REGISTRATION_WINDOW_SECONDS=900
